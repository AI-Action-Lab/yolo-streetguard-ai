APP_ENV=production
APP_NAME=YOLO StreetGuard AI
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://streetguard.example.in

APP_DOMAIN=streetguard.example.in
API_DOMAIN=api.streetguard.example.in
ACME_EMAIL=ops@example.in
NEXT_PUBLIC_API_BASE_URL=https://api.streetguard.example.in/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_SATELLITE_STYLE_URL=
NEXT_PUBLIC_MAP_TERRAIN_STYLE_URL=
CORS_ORIGINS=https://streetguard.example.in

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
OIDC_ISSUER_URL=https://identity.example.in/realms/streetguard
OIDC_AUDIENCE=streetguard-api
OIDC_JWKS_URL=https://identity.example.in/realms/streetguard/protocol/openid-connect/certs

STORAGE_ENDPOINT_URL=https://objects.example.in
# Set only when presigned URLs need a different browser-reachable endpoint.
# STORAGE_PUBLIC_ENDPOINT_URL=https://objects.example.in
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=streetguard-private
STORAGE_USE_SSL=true
STORAGE_SERVER_SIDE_ENCRYPTION=true
STORAGE_SIGNED_URL_TTL_SECONDS=900
SECRETS_DIR=/srv/streetguard/.secrets

MODEL_ARTIFACT_PATH=/srv/streetguard/models/pothole/best.pt
MODEL_CHECKSUM=d4ec8035e55e7db185e82cbfdf97f402264e40024b2d7e6d0e335bce5d321543
DETECTION_DEVICE=cpu

GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
STRICT_COUNTRY_SCOPE=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
