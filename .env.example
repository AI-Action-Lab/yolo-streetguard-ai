APP_ENV=development
APP_NAME=YOLO StreetGuard AI
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+psycopg://streetguard:streetguard@localhost:5432/streetguard
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

OIDC_ISSUER_URL=http://localhost:8080/realms/streetguard
OIDC_AUDIENCE=streetguard-api
OIDC_JWKS_URL=http://localhost:8080/realms/streetguard/protocol/openid-connect/certs

STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=streetguard-private
STORAGE_ACCESS_KEY=streetguard
STORAGE_SECRET_KEY=streetguard
STORAGE_USE_SSL=false
STORAGE_SERVER_SIDE_ENCRYPTION=false
STORAGE_SIGNED_URL_TTL_SECONDS=900

REDIS_URL=redis://localhost:6379/0
MAX_IMAGE_UPLOAD_BYTES=20000000
MAX_IMAGE_PIXELS=50000000
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IMAGE_SIZE=640
DETECTION_DEVICE=cpu
MODEL_PATH=models/pothole/best.pt
MODEL_CHECKSUM=d4ec8035e55e7db185e82cbfdf97f402264e40024b2d7e6d0e335bce5d321543

GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
GEOCODING_TIMEOUT_SECONDS=8

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

MAP_MAX_MARKERS=1000
MAP_MAX_SPAN_DEGREES=360
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

PRODUCT_COUNTRY_CODE=IN
PRODUCT_COUNTRY_NAME=India
STRICT_COUNTRY_SCOPE=false
